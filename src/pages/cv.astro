---
import BaseLayout from "../layouts/BaseLayout.astro";
import TimeLineElement from "../components/cv/TimeLine.astro";
import fs from 'node:fs';
import path from 'node:path';
import { load as yamlLoad } from 'js-yaml';

const resumePath = path.join(process.cwd(), 'resumee', 'francisco-bravo.yml');
const file = fs.readFileSync(resumePath, 'utf8');
const resume = yamlLoad(file) as any;

const basics = resume.content.basics;
const work = resume.content.work || [];
const education = resume.content.education || [];
const certificates = resume.content.certificates || [];
const skills = resume.content.skills || [];
const languages = resume.content.languages || [];

function formatDate(dateStr: string) {
  if (!dateStr) return 'Present';
  const [year, month] = dateStr.split('-');
  const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
  return `${months[parseInt(month) - 1]} ${year}`;
}
---

<BaseLayout title={`${basics.name} - Resume`} sideBarActiveItemID="cv">
  <div class="flex justify-end mb-6 no-print">
    <button onclick="window.print()" class="btn btn-primary btn-sm gap-2">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 6 2 18 2 18 9"></polyline><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path><rect x="6" y="14" width="12" height="8"></rect></svg>
      Print / Save PDF
    </button>
  </div>

  <!-- Header Card -->
  <div class="card bg-base-200 shadow-xl mb-8">
    <div class="card-body">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
          <h1 class="text-4xl font-bold text-base-content">{basics.name}</h1>
          <p class="text-xl text-primary font-semibold mt-1">{basics.headline}</p>
        </div>
        <div class="flex flex-col gap-1 text-sm text-base-content/80">
          <a href={`mailto:${basics.email}`} class="hover:text-primary transition-colors flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
            {basics.email}
          </a>
          <span class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
            {basics.phone}
          </span>
        </div>
      </div>
      <div class="divider my-2"></div>
      <p class="text-base-content/90 leading-relaxed whitespace-pre-line">{basics.summary}</p>
    </div>
  </div>

  <!-- Experience -->
  <div class="mb-8">
    <div class="flex items-center gap-3 mb-6">
      <div class="p-2 bg-primary/10 rounded-lg">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg>
      </div>
      <h2 class="text-3xl font-bold text-base-content">Experience</h2>
    </div>

    <div class="time-line-container">
      {work.map((job: any) => (
        <TimeLineElement
          title={job.position}
          subtitle={`${formatDate(job.startDate)} - ${job.endDate ? formatDate(job.endDate) : 'Present'}`}
          badge={job.name}
        >
          <div class="whitespace-pre-line text-sm md:text-base">{job.summary}</div>
          {job.keywords && job.keywords.length > 0 && (
            <div class="flex flex-wrap gap-2 mt-3">
              {job.keywords.map((kw: string) => (
                <span class="badge badge-outline badge-primary text-xs">{kw}</span>
              ))}
            </div>
          )}
        </TimeLineElement>
      ))}
    </div>
  </div>

  <!-- Skills -->
  <div class="mb-8">
    <div class="flex items-center gap-3 mb-6">
      <div class="p-2 bg-secondary/10 rounded-lg">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-secondary"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>
      </div>
      <h2 class="text-3xl font-bold text-base-content">Skills</h2>
    </div>

    <div class="grid gap-4 md:grid-cols-2">
      {skills.map((skill: any) => (
        <div class="card bg-base-200 shadow-sm">
          <div class="card-body py-4">
            <div class="flex items-center justify-between mb-2">
              <h3 class="font-bold text-base-content">{skill.name}</h3>
              <span class="badge badge-sm badge-accent">{skill.level}</span>
            </div>
            <div class="flex flex-wrap gap-2">
              {skill.keywords.map((kw: string) => (
                <span class="badge badge-outline text-xs">{kw}</span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Education & Certificates -->
  <div class="grid md:grid-cols-2 gap-8 mb-8">
    <div>
      <div class="flex items-center gap-3 mb-4">
        <div class="p-2 bg-accent/10 rounded-lg">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-accent"><path d="M22 10v6M2 10l10-5 10 5-10 5z"></path><path d="M6 12v5c3 3 9 3 12 0v-5"></path></svg>
        </div>
        <h2 class="text-2xl font-bold text-base-content">Education</h2>
      </div>
      <div class="space-y-3">
        {education.map((edu: any) => (
          <div class="card bg-base-200 shadow-sm">
            <div class="card-body py-4">
              <h3 class="font-bold text-base-content">{edu.area}</h3>
              <p class="text-sm text-base-content/70">{edu.institution}</p>
              <p class="text-xs text-base-content/50 mt-1">{edu.startDate} - {edu.endDate}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

    <div>
      <div class="flex items-center gap-3 mb-4">
        <div class="p-2 bg-warning/10 rounded-lg">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-warning"><circle cx="12" cy="8" r="7"></circle><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline></svg>
        </div>
        <h2 class="text-2xl font-bold text-base-content">Certifications</h2>
      </div>
      <div class="space-y-3">
        {certificates.map((cert: any) => (
          <div class="card bg-base-200 shadow-sm">
            <div class="card-body py-4">
              <h3 class="font-bold text-base-content">{cert.name}</h3>
              <p class="text-sm text-base-content/70">{cert.issuer}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Languages -->
  <div class="mb-8">
    <div class="flex items-center gap-3 mb-4">
      <div class="p-2 bg-info/10 rounded-lg">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-info"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
      </div>
      <h2 class="text-2xl font-bold text-base-content">Languages</h2>
    </div>
    <div class="flex flex-wrap gap-4">
      {languages.map((lang: any) => (
        <div class="card bg-base-200 shadow-sm min-w-[200px]">
          <div class="card-body py-4">
            <h3 class="font-bold text-base-content">{lang.language}</h3>
            <p class="text-sm text-base-content/70">{lang.fluency}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>
