---
const { title, subtitle, badge } = Astro.props;
---

<div class="flex group">
  <div class="education__time">
    <span class="w-4 h-4 bg-primary block rounded-full mt-1 shadow-[0_0_10px_rgba(0,0,0,0.3)] group-hover:scale-125 transition-transform"></span>
    <span class="education__line bg-primary/40 block h-full w-[2px] translate-x-[7px]"></span>
  </div>
  <div class="experience__data bd-grid px-5 pb-8 w-full">
    <div class="flex flex-wrap items-center gap-2 mb-1">
      <h3 class="font-bold text-lg text-base-content">{title}</h3>
      {badge && <span class="badge badge-primary badge-sm">{badge}</span>}
    </div>
    <span class="font-medium text-sm text-base-content/70 tracking-wide uppercase">{subtitle}</span>
    <div class="my-3 text-base-content/90 leading-relaxed">
      <slot />
    </div>
  </div>
</div>
